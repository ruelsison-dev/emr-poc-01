{
  "name": "patient-admin-express",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.ts' --max-warnings=0",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "pino": "^8.12.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.5.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.6.1",
    "prettier": "^3.7.3",
    "prisma": "^5.10.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
